<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addCss('/css/experience/components/commerceAssets/promotional-banners.css');
</isscript>

<div class="promotional-banner-wrapper">
    <a href="${pdict.categoryLink}">
        <figure class="mainbanner-figure image-component">
            <picture>
                <isif condition="${pdict.image}">
                    <img src="${pdict.image}" class="img-fluid" alt="${pdict.imageAlt}" />    
                </isif>
            </picture>
        </figure>
    </a>
</div>
