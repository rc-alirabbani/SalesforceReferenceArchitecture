<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
</isscript>

<div class="d-flex align-items-center justify-content-between py-3">
    <isif condition="${pdict.textHeadline !== null}">
        <h3>${pdict.textHeadline}</h3>
    </isif>

    <isif condition="${pdict.buttonText !== null}">
        <div class="btn-wrapper">
            <div class="btn">
                <a class="tile-link" href="${pdict.tileLink}" <isif condition="${pdict.tileNewtab === true}">target="_blank"</isif>>${pdict.buttonText}</a>
            </div>
        </div>
    </isif>
</div>
